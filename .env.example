# Application data mode. Production defaults to live when omitted.
DATA_MODE=live

# Optional structured IPO API. Keys are server-side only.
IPO_DATA_PROVIDER=
IPO_API_BASE_URL=
IPO_API_KEY=
IPO_API_KEY_HEADER=Authorization
IPO_API_KEY_PREFIX=Bearer

# Optional unofficial grey-market provider.
GMP_DATA_PROVIDER=
GMP_API_BASE_URL=
GMP_API_KEY=
GMP_API_KEY_HEADER=Authorization
GMP_API_KEY_PREFIX=Bearer

# Optional authorised/licensed market-data provider.
MARKET_DATA_PROVIDER=
MARKET_API_BASE_URL=
MARKET_API_KEY=
MARKET_API_KEY_HEADER=Authorization
MARKET_API_KEY_PREFIX=Bearer

# Optional publisher or RSS news provider.
NEWS_DATA_PROVIDER=
NEWS_API_BASE_URL=
NEWS_API_KEY=
NEWS_API_KEY_HEADER=Authorization
NEWS_API_KEY_PREFIX=Bearer
NSE_RSS_URL=
NSE_OFFER_DOCUMENTS_RSS_URL=https://nsearchives.nseindia.com/content/RSS/Offer_Documents.xml

# SEBI's public filing pages are not a documented API. Leave recurring HTML
# discovery disabled until permission/usage terms are confirmed.
SEBI_HTML_INGESTION_ENABLED=false

# Required before an external scheduler may invoke the sync endpoint.
CRON_SECRET=

# Comma-separated ChatGPT account emails allowed to use internal admin tools.
ADMIN_EMAILS=

# Source and freshness tuning (minutes).
SEBI_SYNC_INTERVAL_MINUTES=180
IPO_SYNC_INTERVAL_MINUTES=60
GMP_SYNC_INTERVAL_MINUTES=30
SUBSCRIPTION_SYNC_INTERVAL_MINUTES=30
NEWS_SYNC_INTERVAL_MINUTES=30
NSE_FILINGS_SYNC_INTERVAL_MINUTES=15
MARKET_SYNC_INTERVAL_MINUTES=15
GMP_FRESH_MINUTES=30
GMP_RECENT_MINUTES=120
GMP_DELAYED_MINUTES=360

# Retained for a future Worker-compatible PostgreSQL adapter. The deployed
# Sites build uses its bound D1 database unless that adapter is introduced.
DATABASE_URL=
